# BIOFRESH Environment Variables
# Copy this file to .env.local and fill in real values.

# Team login credentials (server-side only, never exposed to browser)
BIOFRESH_ADMIN_EMAIL=admin@biofresh.dev
BIOFRESH_ADMIN_PASSWORD=BioFresh2026!

# Session secret used to sign the auth cookie value
BIOFRESH_SESSION_SECRET=change-this-to-a-long-random-string-in-production

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
